# ====================
# Model Source & Cache
# ====================
# 模型来源（ModelScope）
# MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式
# MODELSCOPE_OFFLINE=1
# ModelScope 模型缓存路径
# MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
# Hugging Face 缓存路径
# HF_HOME=D:/ai_models/huggingface_cache
# 临时文件根目录
# MD_ROOT_DIR=./temp-files/

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=sk-7d54aca704c941c0bc4046658d2477bf
# API 基础地址（阿里云 DashScope）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认 LLM 模型
LLM_DEFAULT_MODEL=qwen-flash
# 默认温度参数
LLM_DEFAULT_TEMPERATURE=0.1

# VLM视觉语言模型
VL_MODEL=qwen3-vl-flash
# [修改] 结构化元数据提取模型 (替代原 ITEM_MODEL)
ITEM_MODEL=qwen-flash
# 知识图谱模型
KG_MODEL=qwen-flash
# [新增] 提取全局元数据时使用的切片数量
GLOBAL_METADATA_CHUNK_K=5

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=E:\project\embedding_model
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备
BGE_DEVICE=cuda:0
# 是否使用半精度
BGE_FP16=True
# BGE 重排序模型路径
BGE_RERANKER_LARGE=E:\project\reranker_model
# 重排序模型设备
BGE_RERANKER_DEVICE=cuda:0
# 重排序模型半精度
BGE_RERANKER_FP16=1
# 项目名称诊断标志 (如果你后续不需要可以注释掉)
ITEM_NAME_DIAG=1

# ====================
# Embedding General
# ====================
# 嵌入向量维度
EMBEDDING_DIM=1536
# 嵌入模型名称
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://192.168.10.150:19530

# [修改] 全局文档集合名 (替代原 ITEM_NAME_COLLECTION)
GLOBAL_COLLECTION=tourism_global_docs_v1
# [修改] 切片详情集合名 (替代原 CHUNKS_COLLECTION)
CHUNK_COLLECTION=tourism_local_chunks_v1
 # 切片提取信息集合
 # CHUNK_EXTRACT_COLLECTION=tourism_chunks_info_v1
# [保留] 实体名称集合名 (给知识图谱备用)
ENTITY_NAME_COLLECTION=kb_graph_entity_names_v3

# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# Graph Database (Neo4j)
# ====================
# Neo4j 连接 URI
NEO4J_URI=bolt://192.168.10.150:7687
# 数据库名（社区版固定）
NEO4J_DATABASE=neo4j
# 用户名
NEO4J_USERNAME=neo4j
# 密码
NEO4J_PASSWORD=hzk123456

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=mongodb://192.168.10.150:27017
# 数据库名
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=192.168.10.150:9000
# 访问密钥
MINIO_ACCESS_KEY=admin
# 私有密钥
MINIO_SECRET_KEY=admin123456
# 存储桶名称
MINIO_BUCKET_NAME=atguigu

# ====================
# Other / MCP Services
# ====================
# MCP Web 搜索服务地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp